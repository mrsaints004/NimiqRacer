# Backend environment variables
# Copy to .env and fill in values.

# Port for the Express server (default: 8787).
PORT=8787

# Turso database URL. Omit for local SQLite file fallback (file:./data/nimiq-racer.sqlite).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Comma-separated list of allowed frontend origins for CORS.
ALLOWED_ORIGINS=http://localhost:5173

# Secret for /api/stats/summary admin endpoint. Omit for open access (dev mode).
ADMIN_SECRET=

# Maximum age in days for event pruning on startup (default: 90).
EVENTS_MAX_AGE_DAYS=90

# Set to "0" if this process is exposed directly (no reverse proxy).
TRUST_PROXY=
