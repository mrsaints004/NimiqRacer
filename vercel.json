{
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/src/**,server/node_modules/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/dashboard", "destination": "/index.html" }
  ]
}
