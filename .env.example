# Frontend environment variables (Vite)
# Copy to .env and fill in values.

# Backend API URL — leave empty for same-origin (Vercel), set for local dev.
VITE_API_URL=http://localhost:8787

# NIM address that receives cosmetic shop payments.
VITE_NIM_RECIPIENT_ADDRESS=

# Price per premium car in Luna (1 NIM = 100000 Luna). Default: 100000 (= 1 NIM).
VITE_CAR_PRICE_LUNA=100000
